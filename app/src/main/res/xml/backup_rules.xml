<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 (API 26-27): la copia de Google aún no se cifraba con el bloqueo de
     pantalla y requireFlags no existe, así que los datos de salud y la clave de
     los audios quedan fuera. Android 9+ usa xml-v28/backup_rules.xml. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="audio_notes/" />
    <exclude domain="file" path="voice_notes/" />
    <exclude domain="sharedpref" path="audio_note_encryption.xml" />
</full-backup-content>
