<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. La copia en la nube (Google) solo se hace si va cifrada de extremo
     a extremo con el bloqueo de pantalla del usuario (PIN, patrón o contraseña).
     Sin bloqueo de pantalla, PillMate no sube nada. Con cifrado, sube todo: así
     una reinstalación o un móvil nuevo recuperan la medicación.
     La transferencia directa entre móviles (cable/Wi-Fi local) se copia entera. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true" />
    <device-transfer />
</data-extraction-rules>
